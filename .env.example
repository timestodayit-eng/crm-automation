# প্যানেলে ঢোকার ইউজারনেম আর পাসওয়ার্ড (নিজের মতো বদলে নিন)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# যেকোনো লম্বা এলোমেলো লেখা দিন (সেশন সুরক্ষার জন্য)
SESSION_SECRET=replace-with-a-long-random-string

# প্যানেল কোন পোর্টে চলবে
PORT=3100

# ডেটাবেস ফাইলের জায়গা
DB_PATH=./data/app.db

# mConnex API-এর মূল ঠিকানা (সাধারণত বদলাতে হবে না)
MCONNEX_BASE_URL=https://mconnex.ebsbd.com/blmconnexapi/api/v1

# BulkSMSBD API ঠিকানা (সাধারণত বদলাতে হবে না; প্রতিটা সাইটের জন্য আলাদা ঠিকানা প্যানেলের সেটিংস → "SMS API ঠিকানা" থেকেও দেওয়া যায়)
SMS_API_URL=https://bulksmsbd.net/api/smsapi

# প্যানেল HTTPS (ডোমেইন + SSL) দিয়ে চললে true করুন
COOKIE_SECURE=false
